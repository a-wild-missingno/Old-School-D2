# Ignored private configuration for scripts/windows/. Copy to
# .hermes/windows-lab.local.env and replace every placeholder locally.
LEGION_SSH_HOST=<WINDOWS_SSH_HOST>
LEGION_SSH_USER=<WINDOWS_SSH_USER>
LEGION_SSH_KEY=<OPTIONAL_PRIVATE_KEY_PATH>
# LEGION_SSH_PORT=22

# Logical aliases only. Do not put these paths in tracked documentation.
ORACLE_RUNTIME=<WINDOWS_ORACLE_RUNTIME_PATH>
EXTERNAL_VALIDATION_RUNTIME=<WINDOWS_KNOWN_GOOD_BASELINE_PATH>
EXTERNAL_TRACE_RUNTIME=<WINDOWS_DEDICATED_TRACE_RUNTIME_PATH>

# Relative paths inside each runtime. Use forward slashes or Windows separators.
LEGION_DESTINY_EXE_RELATIVE=destiny2.exe
LEGION_SUNRISE_DLL_RELATIVE=<SUNRISE_DLL_RELATIVE_PATH>
LEGION_SETTINGS_RELATIVE=settings.json
LEGION_MOVEMENT_RELATIVE=movement.json
LEGION_SUNRISE_LOG_RELATIVE=<SUNRISE_LOG_RELATIVE_PATH>

# Comma-separated Windows ports to show in status; leave blank if none are relevant.
LEGION_RELEVANT_PORTS=
# Exact process names only, without .exe, for project-controlled cleanup.
LEGION_PROJECT_CLEANUP_PROCESS_NAMES=
# Dedicated targets only; external-validation is always denied even if listed here.
LEGION_TRACE_DEPLOY_ALLOWED_RUNTIMES=external-trace,oracle
# Public HTTPS probes that must be unreachable from the Legion.
LEGION_ISOLATION_PUBLIC_HOSTS=1.1.1.1,8.8.8.8
