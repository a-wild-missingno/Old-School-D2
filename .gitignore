# Raw captures/logs may contain sensitive LAN/device data: review before committing.
captures/
logs/
*.pcap
*.pcapng
*.cap
*.har
*.etl
*.evtx

# Local/private lab configuration.
.env
.env.*
local.*
*.local
private/
secrets/
credentials/
tokens/

# Never commit Destiny/Bungie binaries or assets.
*.exe
*.dll
*.so
*.dylib
*.pak
*.pkg
*.bin
*.dat
*.wem
*.bnk
*.usm
*.bik
*.bk2
*.mp4
*.mov
*.mp3
*.wav
*.ogg
*.flac
*.dds
*.png
*.jpg
*.jpeg
*.tga
*.fbx
*.obj
*.blend
*.unity3d

# Never commit keys/secrets/tokens.
*.key
*.pem
*.p12
*.pfx
*.crt
*.csr
id_rsa*
id_ed25519*
